 {
  "id": "seg_001",
  "category": "word_final_consonant",
  "categoryLabel": "词尾辅音",
  "targetForm": "I've",
  "ipa": "/aɪv/",
  "referenceText": "I've been there before.",
  "commonError": "devoicing /v/ to /f/, or dropping it entirely",
  "practiceNote": "上齿轻触下唇，保持声带振动；可拉长成 aaaai-vvv 感受振动",
  "type": "segmental"
 },
 {
  "id": "seg_002",
  "category": "word_final_consonant",
  "categoryLabel": "词尾辅音",
  "targetForm": "I'll",
  "ipa": "/aɪl/",
  "referenceText": "I'll call you later.",
  "commonError": "dark /l/ replaced with a vowel glide, or dropped entirely",
  "practiceNote": "舌尖确实要贴住上齿龈，不只是靠近；先练 feel/will/call",
  "type": "segmental"
 },
 {
  "id": "seg_003",
  "category": "word_final_consonant",
  "categoryLabel": "词尾辅音",
  "targetForm": "I'm",
  "ipa": "/aɪm/",
  "referenceText": "I'm going home now.",
  "commonError": "/m/ too short or swallowed, losing the nasal hum",
  "practiceNote": "双唇完全闭合并保持，感受鼻腔的嗡嗡延续感",
  "type": "segmental"
 },
 {
  "id": "seg_004",
  "category": "consonant_cluster",
  "categoryLabel": "辅音连缀",
  "targetForm": "months",
  "ipa": "/mʌnts/",
  "referenceText": "It took three months to finish.",
  "commonError": "dropping the final /s/, or forcing /θs/ literally",
  "practiceNote": "/θs/ 在自然语流中同化成 /ts/，结尾听起来像 ants",
  "type": "segmental"
 },
 {
  "id": "seg_005",
  "category": "consonant_cluster",
  "categoryLabel": "辅音连缀",
  "targetForm": "asked",
  "ipa": "/ɑːskt/ → /ɑːst/",
  "referenceText": "I asked him a question.",
  "commonError": "keeping all three consonants /skt/, unnaturally hard to articulate",
  "practiceNote": "口语中 /k/ 常脱落，简化为 /ɑːst/",
  "type": "segmental"
 },
 {
  "id": "seg_006",
  "category": "silent_letter",
  "categoryLabel": "哑音字母",
